# ─── Google Gemini API ───────────────────────────────────────────
# Get your free key at: https://aistudio.google.com
GOOGLE_API_KEY=your_gemini_api_key_here

# ─── Jira Configuration ─────────────────────────────────────────
# Domain: just the subdomain part, no https://
# e.g. if your Jira is at mycompany.atlassian.net → enter mycompany.atlassian.net
JIRA_DOMAIN=yourcompany.atlassian.net

# The email you use to log into Jira
JIRA_EMAIL=you@company.com

# API token from: https://id.atlassian.com/manage-api-tokens
JIRA_API_TOKEN=your_jira_api_token_here

# Project key — the short code before issue numbers e.g. MIS in MIS-1
JIRA_PROJECT_KEY=MIS